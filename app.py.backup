""", unsafe_allow_html=True)


def main():
    """主函数"""
    # 标题区域 - 现代设计
    st.markdown("""
    <div style="margin-bottom: 2rem;">
        <h1 style="margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.75rem;">
            <span style="font-size: 2.5rem;">⛰️</span>
            Trail Master
        </h1>
        <p style="color: var(--text-secondary); font-size: 1.125rem; margin: 0;">
            上传训练记录，获取精准的赛道配速分析与完赛时间预测
        </p>
    </div>
    """, unsafe_allow_html=True)

    # 初始化session state
    init_session_state()

    # 侧边栏
    render_sidebar()

    # 主界面
    if st.session_state.get('analysis_started'):
        render_analysis()
    else:
        render_instructions()


def init_session_state():
    """初始化session state"""
    defaults = {
        'predictor': None,
        'file_handler': FileHandler(str(ROOT_DIR / 'temp')),
        # 当前上传的文件（用户可修改）
        'uploaded_gpx': None,
        'uploaded_fits': [],
        'uploaded_effort': 1.0,
        # 分析快照（点击开始分析时固化）
        'analysis_snapshot': None,  # {'gpx_file', 'fit_files', 'effort_factor'}
        # 分析状态
        'analysis_started': False,
        'analysis_complete': False,
        'prediction_result': None,
    }

    for key, value in defaults.items():
        if key not in st.session_state:
            st.session_state[key] = value


def render_sidebar():
    """渲染侧边栏 - 现代设计"""
    with st.sidebar:
        # 侧边栏标题
        st.markdown("""
        <div style="margin-bottom: 1.5rem;">
            <h2 style="margin: 0; font-size: 1.25rem; color: var(--text-primary);">
                🎛️ 控制面板
            </h2>
            <p style="margin: 0.25rem 0 0 0; font-size: 0.75rem; color: var(--text-muted);">
                配置参数并开始分析
            </p>
        </div>
        """, unsafe_allow_html=True)

        # 如果正在分析中，禁用输入
        if st.session_state.get('analysis_started') and not st.session_state.get('analysis_complete'):
            st.markdown("""
            <div style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, rgba(6, 182, 212, 0.1) 100%);
                        border: 1px solid rgba(99, 102, 241, 0.2);
                        border-radius: 0.75rem;
                        padding: 1rem;
                        text-align: center;
                        margin-bottom: 1rem;">
                <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">⏳</div>
                <div style="color: var(--text-primary); font-weight: 600; font-size: 0.875rem;">分析进行中</div>
                <div style="color: var(--text-muted); font-size: 0.75rem; margin-top: 0.25rem;">请稍候...</div>
            </div>
            """, unsafe_allow_html=True)
            st.button("🔄 重置", on_click=reset_analysis, use_container_width=True)
            return

        # 如果分析完成，显示重置按钮
        if st.session_state.get('analysis_complete'):
            st.markdown("""
            <div style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(6, 182, 212, 0.1) 100%);
                        border: 1px solid rgba(16, 185, 129, 0.2);
                        border-radius: 0.75rem;
                        padding: 1rem;
                        text-align: center;
                        margin-bottom: 1rem;">
                <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">✅</div>
                <div style="color: var(--text-primary); font-weight: 600; font-size: 0.875rem;">分析完成</div>
            </div>
            """, unsafe_allow_html=True)
            st.button("🔄 重新开始", on_click=reset_analysis, use_container_width=True)
            st.divider()

        # 数据上传区域
        st.markdown("""
        <div style="margin-bottom: 1rem;">
            <h3 style="margin: 0; font-size: 1rem; color: var(--text-primary); display: flex; align-items: center; gap: 0.5rem;">
                <span style="color: var(--primary);">📁</span> 数据上传
            </h3>
        </div>
        """, unsafe_allow_html=True)

        # 赛道上传
        gpx_file = st.file_uploader(
            "上传目标赛道 (GPX)",
            type=['gpx'],
            key="gpx_uploader",
            help="上传比赛的GPX路线文件"
        )

        # 训练记录上传
        fit_files = st.file_uploader(
            "上传个人记录 (FIT)",
            type=['fit'],
            accept_multiple_files=True,
            key="fits_uploader",
            help="上传历史训练记录，建议至少5个文件，15-20个精品FIT效果最佳"
        )

        # 显示上传状态
        if gpx_file:
            st.markdown(f"""
            <div style="background-color: rgba(16, 185, 129, 0.1);
                        border: 1px solid rgba(16, 185, 129, 0.2);
                        border-radius: 0.5rem;
                        padding: 0.75rem;
                        margin-top: 0.5rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <span style="color: var(--success);">✓</span>
                    <span style="color: var(--text-primary); font-size: 0.875rem; font-weight: 500;">赛道已加载</span>
                </div>
                <div style="color: var(--text-muted); font-size: 0.75rem; margin-top: 0.25rem; margin-left: 1.5rem;">
                    {gpx_file.name}
                </div>
            </div>
            """, unsafe_allow_html=True)

        if fit_files:
            st.markdown(f"""
            <div style="background-color: rgba(6, 182, 212, 0.1);
                        border: 1px solid rgba(6, 182, 212, 0.2);
                        border-radius: 0.5rem;
                        padding: 0.75rem;
                        margin-top: 0.5rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <span style="color: var(--accent);">✓</span>
                    <span style="color: var(--text-primary); font-size: 0.875rem; font-weight: 500;">训练记录已加载</span>
                </div>
                <div style="color: var(--text-muted); font-size: 0.75rem; margin-top: 0.25rem; margin-left: 1.5rem;">
                    {len(fit_files)} 个文件
                </div>
            </div>
            """, unsafe_allow_html=True)

        st.divider()

        # 努力程度滑块
        st.markdown("""
        <div style="margin-bottom: 1rem;">
            <h3 style="margin: 0; font-size: 1rem; color: var(--text-primary); display: flex; align-items: center; gap: 0.5rem;">
                <span style="color: var(--primary);">⚡</span> 比赛状态
            </h3>
        </div>
        """, unsafe_allow_html=True)

        effort_factor = st.slider(
            "努力程度系数",
            min_value=0.8,
            max_value=1.2,
            value=1.0,
            step=0.01,
            key="effort_slider",
            help="1.0 = 平时平均水平 (P50)\n1.1-1.2 = 比赛状态 (接近 P90)\n0.8-0.9 = 保守策略"
        )

        # 显示努力程度说明 - 使用卡片样式
        if effort_factor < 0.95:
            st.markdown(f"""
            <div style="background: linear-gradient(135deg, rgba(6, 182, 212, 0.1) 0%, rgba(99, 102, 241, 0.1) 100%);
                        border: 1px solid rgba(6, 182, 212, 0.2);
                        border-radius: 0.75rem;
                        padding: 1rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                    <span style="font-size: 1.25rem;">🎯</span>
                    <span style="color: var(--accent); font-weight: 600; font-size: 0.875rem;">保守策略</span>
                </div>
                <div style="color: var(--text-secondary); font-size: 0.75rem;">
                    系数: {effort_factor:.2f}x · 适合长距离或恢复期比赛
                </div>
            </div>
            """, unsafe_allow_html=True)
        elif effort_factor > 1.05:
            st.markdown(f"""
            <div style="background: linear-gradient(135deg, rgba(245, 158, 11, 0.1) 0%, rgba(239, 68, 68, 0.1) 100%);
                        border: 1px solid rgba(245, 158, 11, 0.2);
                        border-radius: 0.75rem;
                        padding: 1rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                    <span style="font-size: 1.25rem;">🔥</span>
                    <span style="color: var(--warning); font-weight: 600; font-size: 0.875rem;">比赛状态</span>
                </div>
                <div style="color: var(--text-secondary); font-size: 0.75rem;">
